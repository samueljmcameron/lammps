##### overdamped dynamics of a sphere (with dipole attached to it) in 2D #####

variable        rng string uniform
variable        seed string 1289012
variable        temp string 0.0001
variable        gamma_t string 100.0
variable        gamma_r string 0.7
variable        params string ${rng}_${temp}_${gamma_r}_${gamma_t}

variable  timezoom equal stride2(1000,2000,100,1375,1380,1)

units           lj
atom_style      atomic
dimension       2
newton off


region ll_tri prism -0.5 -0.4 -0.5 -0.1 -0.5 0.5 -0.1 0 0 side out
region lr_tri prism -0.4 0.5 -0.5 -0.1 -0.5 0.5 0.9 0 0 side out
region ul_tri prism -0.6 -0.5 0.1 0.5 -0.5 0.5 0.1 0 0 side out
region ur_tri prism 0.5 1.4 0.1 0.5 -0.5 0.5 -0.9 0 0 side out
region interior intersect 4 ll_tri lr_tri ul_tri ur_tri

read_data single_cell.data
neighbor        0.04 bin
neigh_modify    delay 1 check yes exclude type 1 2 exclude type 2 2

#pair_style none
pair_style	soft 0.04
pair_coeff 1 1 1.0
pair_coeff 1 2 0.0
pair_coeff 2 2 0.0

variable atomtype atom type
variable is_alive atom v_atomtype==1

group alive dynamic all var is_alive


fix integrator alive brownian 1e-3 ${seed} rng uniform gamma_t ${gamma_t}
fix birthdeath all organism/birthdeath/logistic 1 2 489012 0.04 0.0001 0.04 50

fix wall all wall/region interior harmonic 10000.0 1.0 0.04

#initialisation for the main run

# MSD

dump            1 all custom 1000 dump_2d.lammpstrj id type &
               x y z vx vy vz xu yu zu fx fy fz
dump_modify     1 first yes sort id 

timestep        0.01
#thermo          100

# main run
run		100000
